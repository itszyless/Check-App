{
  "name": "check",
  "version": "1.6.0",
  "description": "Check \u2014 a fast Windows utility app with dashboard, clipboard history, temp cleaner, startup manager, screenshots, quick launcher and automatic updates.",
  "main": "main.js",
  "author": "itszyless",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.itszyless.check",
    "productName": "Check",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Check"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "itszyless",
        "repo": "Check-App"
      }
    ]
  }
}
